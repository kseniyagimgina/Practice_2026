<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CommandLib\CommandLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\FileSystemCommands\bin\$(Configuration)\$(TargetFramework)\FileSystemCommands.dll" 
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="EnsureFileSystemCommandsBuilt" BeforeTargets="PrepareForRun">
  <MSBuild Projects="..\FileSystemCommands\FileSystemCommands.csproj" Targets="Build" />
  </Target>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
